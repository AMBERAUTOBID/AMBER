# Pre-launch gate. Set this and the whole site (pages AND /api routes) is
# replaced by a "coming soon" holding page for everyone except visitors who
# have unlocked it once via https://<domain>/?key=<this value>.
#
# LEAVE IT UNSET TO GO LIVE - the gate switches itself off when absent, so
# launching is a one-line change in the Vercel dashboard, not a code edit.
#
# Needed because Vercel's own Deployment Protection does not cover production
# domains on the Pro plan without a $150/month add-on - see the comment at the
# top of src/shared/gate/preLaunchGate.ts.
#
# Not set in local development on purpose: localhost isn't public, and gating
# it would just add friction to every dev session.
SITE_GATE_PASSWORD=

# Gmail account used to send contact-form emails.
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Google/Workspace account).
GMAIL_USER=info@smartautobid.com
GMAIL_APP_PASSWORD=

# Optional: override the inbox that receives contact-form submissions.
# Defaults to info@smartautobid.com if unset.
CONTACT_EMAIL_TO=info@smartautobid.com

# reCAPTCHA v3 (spam protection for the contact form).
# 1. Go to https://www.google.com/recaptcha/admin/create
# 2. Register a site, choose "reCAPTCHA v3", and add your domain(s)
#    (e.g. smartautobid.com, and localhost for local testing).
# 3. Copy the Site Key and Secret Key below.
# Without these set, the contact form still works but has no bot protection.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Analytics 4 (site traffic tracking).
# 1. Go to https://analytics.google.com/ and create a GA4 property for smartautobid.com.
# 2. Under Admin > Data Streams, add a Web stream and copy its Measurement ID (starts with "G-").
# Without this set, no analytics script loads and the cookie banner never appears.
# With it set, the banner shows on first visit and analytics only loads after a visitor accepts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Apibara Copart & IAAI Auction Data API (https://apibara.tech).
# Third-party aggregator (not an official Copart/IAAI integration) powering
# the /inventory search + detail prototype pages. Sign up at
# https://apibara.tech/en/register (free tier available, no card required)
# and copy your key from the dashboard.
APIBARA_API_KEY=

# NOTE: the bot's own posting settings (channel/topic IDs for the LIVE
# Auctions and Buy Now sections) are GitHub Actions secrets, not Vercel env
# vars - see scripts/telegram-bot/README.md. Only the webhook below runs
# here on the website.
#
# Telegram bot webhook (handles the EN/RU/LT language-switch buttons on
# posts made by scripts/telegram-bot - see that folder's README.md for the
# full setup, including the one-time call that registers this URL with
# Telegram). Only needed for the webhook route itself; the bot's own
# posting credentials live as GitHub Actions secrets, not here.
TELEGRAM_BOT_TOKEN=
# Any random string you generate yourself - verifies webhook calls really
# came from Telegram (sent back as the secret_token param when registering
# the webhook).
TELEGRAM_WEBHOOK_SECRET=

# Vercel KV (Storage tab -> KV, powered by Upstash) - caches each bot post's
# 3 language captions so a button tap never needs to re-hit Apibara. Vercel
# sets these automatically once you provision the integration; add the same
# two values as GitHub Actions secrets too (the bot script writes to this
# store, the webhook above reads from it).
KV_REST_API_URL=
KV_REST_API_TOKEN=
